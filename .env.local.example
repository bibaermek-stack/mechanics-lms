# ============================================================
# Mechanics AI LMS — Environment Variables
# Copy this file to .env.local and fill in real values.
# The app runs with local mock data/AI if these are left empty,
# so you can demo it immediately and wire real services later.
# ============================================================

# --- Firebase (Authentication, Firestore, Storage) ---
# Get these from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to force mock mode even if Firebase keys are present
NEXT_PUBLIC_USE_MOCK_BACKEND=true

# --- AI Provider: "openai" | "gemini" | "mock" ---
NEXT_PUBLIC_AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-pro

# --- Google Workspace Integration ---
# OAuth client for Google Login, Sheets, Forms, Drive, Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_SHEETS_ID=
GOOGLE_FORMS_ID=
GOOGLE_DRIVE_FOLDER_ID=

# --- Misc ---
NEXT_PUBLIC_APP_NAME=Механика AI LMS
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (accounts, roles, teacher↔student links) -----------------------
# Supabase Dashboard → Project Settings → API
# Leave empty to run in demo mode (localStorage, no real accounts).
NEXT_PUBLIC_SUPABASE_URL=
# Newer projects call this the "publishable" key (sb_publishable_...); older
# ones call it the anon key. Either name works — set whichever you were given.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
